AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=<tu-api-key-de-azure>
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.3-codex
AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=gpt-4o-transcribe
MOCK_AI=false
AI_PROTO_API_KEY=<clave-secreta-para-proteger-la-api>
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_PROTO_MAX_UPLOAD_MB=2048
AI_PROTO_UPLOAD_CHUNK_MB=4
AI_PROTO_ALLOWED_UPLOAD_EXTENSIONS=.mp3,.mp4,.wav,.m4a,.webm,.mov,.aac,.ogg,.flac,.mpeg,.mpga
